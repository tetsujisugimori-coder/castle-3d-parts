{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "review_note": {
      "type": "string",
      "minLength": 1
    },
    "source_file_sha256": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "checked_at": {
      "type": "string",
      "minLength": 1,
      "format": "date"
    },
    "measurements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^SRC-[0-9]{4}/L[0-9]{2}/M[0-9]{2}$"
          },
          "source_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^SRC-[0-9]{4}$"
          },
          "location_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^L[0-9]{2}$"
          },
          "source_location_sha256": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "statistic": {
            "type": "string",
            "enum": [
              "single",
              "range",
              "mean",
              "maximum",
              "minimum"
            ]
          },
          "unit": {
            "type": "string",
            "enum": [
              "mm",
              "cm",
              "m",
              "count"
            ]
          },
          "value": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "lower": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "upper": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "original_text": {
            "type": "string",
            "minLength": 1
          },
          "reported_scope": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "source_id",
          "location_id",
          "source_location_sha256",
          "name",
          "target",
          "statistic",
          "unit",
          "value",
          "lower",
          "upper",
          "original_text",
          "reported_scope"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "identifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^SRC-[0-9]{4}$"
          },
          "location_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^L[0-9]{2}$"
          },
          "source_location_sha256": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Z]+[0-9]+$"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "source_id",
          "location_id",
          "source_location_sha256",
          "values"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "review_note",
    "source_file_sha256",
    "checked_at",
    "measurements",
    "identifiers"
  ],
  "additionalProperties": false
}
