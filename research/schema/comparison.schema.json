{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^CMP-[0-9]{4}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "observation_id": {
            "type": "string",
            "pattern": "^OBS-[0-9]{4}$"
          },
          "site": {
            "type": "string",
            "minLength": 1
          },
          "region": {
            "type": "string",
            "minLength": 1
          },
          "chronology": {
            "type": "object",
            "properties": {
              "value": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "basis": {
                "type": "string",
                "minLength": 1
              },
              "source_refs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "source_id": {
                      "type": "string",
                      "pattern": "^SRC-[0-9]{4}$"
                    },
                    "location_id": {
                      "type": "string",
                      "pattern": "^L[0-9]{2}$"
                    }
                  },
                  "required": [
                    "source_id",
                    "location_id"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0,
                "uniqueItems": true
              }
            },
            "required": [
              "value",
              "basis",
              "source_refs"
            ],
            "additionalProperties": false
          },
          "measurement_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "observation_id": {
                  "type": "string",
                  "pattern": "^OBS-[0-9]{4}$"
                },
                "measurement_id": {
                  "type": "string",
                  "pattern": "^M[0-9]{2}$"
                },
                "concept": {
                  "enum": [
                    "posthole_count",
                    "posthole_spacing_unspecified",
                    "posthole_spacing_centres",
                    "posthole_spacing_edges",
                    "remaining_depth",
                    "original_embedment",
                    "posthole_size"
                  ]
                },
                "value": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "lower": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "upper": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "unit": {
                  "enum": [
                    "m",
                    "cm",
                    "mm",
                    "count"
                  ]
                },
                "statistic": {
                  "enum": [
                    "single",
                    "mean",
                    "range"
                  ]
                },
                "target": {
                  "type": "string",
                  "minLength": 1
                },
                "reported_scope": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "observation_id",
                "measurement_id",
                "concept",
                "value",
                "lower",
                "upper",
                "unit",
                "statistic",
                "target",
                "reported_scope"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "limits": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "observation_id",
          "site",
          "region",
          "chronology",
          "measurement_refs",
          "limits"
        ],
        "additionalProperties": false
      },
      "minItems": 2,
      "uniqueItems": true
    },
    "comparability": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "revision_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "revision",
          "date",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "id",
    "revision",
    "name",
    "question",
    "members",
    "comparability",
    "limitations",
    "revision_history"
  ],
  "additionalProperties": false
}
