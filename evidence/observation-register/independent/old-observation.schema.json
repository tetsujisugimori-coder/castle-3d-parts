{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tetsujisugimori-coder/castle-3d-parts/observations/schema/observation.schema.json",
  "title": "Reported archaeological observations, layer 2",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^OBS-[0-9]{4}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "site": {
      "type": "string",
      "minLength": 1
    },
    "classification": {
      "type": "string",
      "enum": [
        "feature",
        "artifact",
        "other"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "postholes",
        "small_roundwood",
        "architectural_wood",
        "wood_debris",
        "mixed_wood"
      ]
    },
    "scope": {
      "type": "string",
      "enum": [
        "individual",
        "collection"
      ]
    },
    "role": {
      "type": "string",
      "enum": [
        "primary",
        "comparison"
      ]
    },
    "original_ids": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "minLength": 1
          },
          "reference_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^R[0-9]{2}$"
            },
            "uniqueItems": true,
            "minItems": 1
          }
        },
        "required": [
          "value",
          "reference_ids"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "position": {
      "type": "object",
      "properties": {
        "reported_location": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "reference_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^R[0-9]{2}$"
              },
              "uniqueItems": true,
              "minItems": 1
            }
          },
          "required": [
            "text",
            "reference_ids"
          ],
          "additionalProperties": false
        },
        "findspot": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "reference_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^R[0-9]{2}$"
              },
              "uniqueItems": true,
              "minItems": 1
            }
          },
          "required": [
            "text",
            "reference_ids"
          ],
          "additionalProperties": false
        },
        "original_installation": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "interpretation_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "^I[0-9]{2}$"
            }
          },
          "required": [
            "text",
            "interpretation_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "reported_location",
        "findspot",
        "original_installation"
      ],
      "additionalProperties": false
    },
    "condition": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "reference_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^R[0-9]{2}$"
          },
          "uniqueItems": true,
          "minItems": 1
        }
      },
      "required": [
        "text",
        "reference_ids"
      ],
      "additionalProperties": false
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^F[0-9]{2}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "summary",
              "quote"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "reference_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^R[0-9]{2}$"
            },
            "uniqueItems": true,
            "minItems": 1
          }
        },
        "required": [
          "id",
          "kind",
          "text",
          "reference_ids"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "source_interpretations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^I[0-9]{2}$"
          },
          "attributed_to": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "reference_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^R[0-9]{2}$"
            },
            "uniqueItems": true,
            "minItems": 1
          }
        },
        "required": [
          "id",
          "attributed_to",
          "text",
          "reference_ids"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "measurements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^M[0-9]{2}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "type": "string",
            "enum": [
              "reported",
              "measured",
              "source_estimate"
            ]
          },
          "statistic": {
            "type": "string",
            "enum": [
              "single",
              "range",
              "mean",
              "maximum",
              "minimum"
            ]
          },
          "value": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "lower": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "upper": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "unit": {
            "type": "string",
            "enum": [
              "mm",
              "cm",
              "m",
              "count"
            ]
          },
          "original_text": {
            "type": "string",
            "minLength": 1
          },
          "original_unit": {
            "type": "string",
            "enum": [
              "mm",
              "cm",
              "m",
              "count"
            ]
          },
          "original_value": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "original_lower": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "original_upper": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "reported_scope": {
            "type": "string",
            "minLength": 1
          },
          "reference_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^R[0-9]{2}$"
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "method": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "interpretation_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^I[0-9]{2}$"
          }
        },
        "required": [
          "id",
          "name",
          "target",
          "basis",
          "statistic",
          "value",
          "lower",
          "upper",
          "unit",
          "original_text",
          "original_unit",
          "original_value",
          "original_lower",
          "original_upper",
          "reported_scope",
          "reference_ids",
          "method",
          "interpretation_id"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^R[0-9]{2}$"
          },
          "source_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^SRC-[0-9]{4}$"
          },
          "location_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^L[0-9]{2}$"
          },
          "source_locator": {
            "type": "string",
            "minLength": 1
          },
          "source_location_sha256": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "printed_pages": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "pdf_pages": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "uniqueItems": true
          },
          "figures": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "tables": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "evidence_url": {
            "type": "string",
            "minLength": 1,
            "format": "uri"
          },
          "source_file_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "text_status": {
            "type": "string",
            "enum": [
              "checked",
              "not_checked"
            ]
          },
          "figure_status": {
            "type": "string",
            "enum": [
              "checked",
              "not_checked"
            ]
          },
          "method": {
            "type": "string",
            "enum": [
              "pdf_text_and_page_image",
              "pdf_text",
              "webpage_text",
              "source_register_only"
            ]
          },
          "checked_at": {
            "type": "string",
            "minLength": 1,
            "format": "date"
          },
          "checked_scope": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "source_id",
          "location_id",
          "source_locator",
          "source_location_sha256",
          "printed_pages",
          "pdf_pages",
          "figures",
          "tables",
          "evidence_url",
          "source_file_sha256",
          "text_status",
          "figure_status",
          "method",
          "checked_at",
          "checked_scope"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "verification": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "partial_checked",
            "not_checked"
          ]
        },
        "meaning": {
          "type": "string",
          "const": "reported_observation_not_historical_proof"
        }
      },
      "required": [
        "status",
        "meaning"
      ],
      "additionalProperties": false
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "member_of",
              "same_object_candidate",
              "overlap_candidate",
              "comparison"
            ]
          },
          "target_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^OBS-[0-9]{4}$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "type",
          "target_id",
          "reason"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "id",
    "name",
    "site",
    "classification",
    "kind",
    "scope",
    "role",
    "original_ids",
    "position",
    "condition",
    "facts",
    "source_interpretations",
    "measurements",
    "references",
    "verification",
    "relations",
    "unknowns",
    "notes"
  ],
  "additionalProperties": false
}
