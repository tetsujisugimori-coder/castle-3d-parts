{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "revision",
    "created_at",
    "site",
    "facility",
    "part_id",
    "hypothesis",
    "status",
    "reason",
    "author",
    "support",
    "counterevidence",
    "unknowns",
    "competitors",
    "previous",
    "change_evidence",
    "cad",
    "parameters"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^DEC-[0-9]{4}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "site": {
      "type": "string",
      "minLength": 1
    },
    "facility": {
      "type": "string",
      "minLength": 1
    },
    "part_id": {
      "type": "string",
      "minLength": 1
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "sha256",
        "commit",
        "path"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "status": {
      "enum": [
        "held",
        "adopted",
        "rejected"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "support": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "counterevidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "competitors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "previous": {
      "type": [
        "string",
        "null"
      ]
    },
    "change_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "cad": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligibility",
        "write_allowed"
      ],
      "properties": {
        "eligibility": {
          "enum": [
            "reference_only",
            "approved"
          ]
        },
        "write_allowed": {
          "type": "boolean"
        }
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "unit",
          "measurement_target",
          "application_site",
          "historical_value",
          "hypothesis_value",
          "prototype_value",
          "basis",
          "confirmation",
          "evidence_id",
          "method",
          "limitations"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "measurement_target": {
            "type": "string",
            "minLength": 1
          },
          "application_site": {
            "type": "string",
            "minLength": 1
          },
          "historical_value": {
            "type": "null"
          },
          "hypothesis_value": {
            "type": "null"
          },
          "prototype_value": {
            "type": [
              "number",
              "string",
              "null"
            ]
          },
          "basis": {
            "enum": [
              "A",
              "B",
              "C",
              "D"
            ]
          },
          "confirmation": {
            "type": "string",
            "minLength": 1
          },
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      },
      "uniqueItems": true
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
